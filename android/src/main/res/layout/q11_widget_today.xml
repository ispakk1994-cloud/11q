<?xml version="1.0" encoding="utf-8"?>
<!-- 11Q 위젯 A · 오늘 할 일 (시안 WidgetSizes 갤럭시 4×2 · 늘이면 줄이 더 보임) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q11_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/q11_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/q11_bg_glass"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/q11_head"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/q11_logo"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:background="@drawable/q11_round_white"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/q11_widget_title"
                android:textColor="#FFFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/q11_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/q11_widget_today"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/q11_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#9EFFFFFF"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/q11_plus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/q11_circle_white"
                android:contentDescription="@string/q11_widget_add"
                android:padding="7dp"
                android:src="@drawable/q11_ic_plus" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/q11_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/q11_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/q11_widget_open_app"
                android:textColor="#9EFFFFFF"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
