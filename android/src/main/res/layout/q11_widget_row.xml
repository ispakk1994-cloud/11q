<?xml version="1.0" encoding="utf-8"?>
<!-- 할 일 한 줄(보통) · 0.8.0 다듬기: 제목 500 · 날짜 400 · 시각 자리 고정 · 체크칸 선 얇게 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q11_row"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/q11_chk"
        android:layout_width="34dp"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/q11_chk_box"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/q11_widget_check"
            android:src="@drawable/q11_chk_round" />

        <ImageView
            android:id="@+id/q11_chk_fill"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|start"
            android:importantForAccessibility="no"
            android:src="@drawable/q11_chk_round_fill"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/q11_chk_mark"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical|start"
            android:importantForAccessibility="no"
            android:padding="3.5dp"
            android:src="@drawable/q11_ic_check"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/q11_body"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/q11_now"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/q11_round_white"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/q11_flag"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/q11_round_white"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/q11_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp" />

        <!-- 한 주 위젯: 프로젝트 단계 칩(국감 대응 자료 · 3/4) · 오늘 할 일 위젯은 안 씀 -->
        <TextView
            android:id="@+id/q11_step"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/q11_round_white"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxWidth="150dp"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/q11_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
