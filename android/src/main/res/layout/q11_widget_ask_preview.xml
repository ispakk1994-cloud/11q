<?xml version="1.0" encoding="utf-8"?>
<!-- 0.8.0 자료에 묻기 고르기 화면 미리 보기(안드로이드 12 이상) · 유리 · 검색창 하나 -->
<!-- 0.8.1 위젯 바탕 = 위젯 전체(투명 · @android:id/background): 안드로이드 12 이상 런처는 위젯 바탕을 찾아 둥글게 자르는데
     바탕이 투명하면 알약을 바탕으로 보고 잘라 네온(모서리 6) · 스위스(네모) 알약 모서리 선이 끊겼음(One UI · 11/21 상준님 사진) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/q11_ask_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/q11_round_white"
                android:backgroundTint="#FF6C5AFF"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="@string/q11_widget_title"
                android:textColor="#FFFFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/q11_ask_hint"
                android:textColor="#9EFFFFFF"
                android:textSize="15.5sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#24FFFFFF" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/q11_ic_mic"
                    android:tint="#FFB8AFFF" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
