                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="24"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

