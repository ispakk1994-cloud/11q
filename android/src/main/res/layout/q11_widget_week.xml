                android:layout_height="16dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="36dp"
                android:textColor="#9EFFFFFF"
                android:textSize="12sp"
