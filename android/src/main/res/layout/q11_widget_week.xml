<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 5 · 한 주 · 0.8.0 다듬기(시안 WidgetPolish): 여백 좌우 16 · 위 12 · 아래 10 · 로고 없음 · ＋ 옅은 바탕 · 고른 날만 꽉 찬 강조색 · 온전한 줄 + `+N개 더` -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q11_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/q11_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/q11_bg_glass"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- 머리: 왼쪽(한 주 · 고른 날) = 앱의 한 주 · 오른쪽 ＋ = 고른 날 마감으로 작은 창 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/q11_wk_open"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/q11_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/q11_week_label"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/q11_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#9EFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/q11_wk_add_area"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="12dp">

                <FrameLayout
                    android:id="@+id/q11_wk_add_o"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/q11_wk_add_i"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/q11_f_pill">

                        <ImageView
                            android:id="@+id/q11_wk_add_icon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/q11_ic_plus" />
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- 띠: 오늘부터 7일 -->
        <LinearLayout
            android:id="@+id/q11_wk_strip"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

