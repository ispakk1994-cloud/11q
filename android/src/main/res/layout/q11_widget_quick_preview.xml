<?xml version="1.0" encoding="utf-8"?>
<!-- 0.8.0 바로 적기 고르기 화면 미리 보기(안드로이드 12 이상) · 유리 · 다듬기(시안 WidgetPolish) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/q11_bg_glass"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 머리(바로 적기) = 앱 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/q11_quick_label"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 적기(주 버튼) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/q11_f_r12"
                    android:backgroundTint="#FF6C5AFF"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/q11_ic_plus" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/q11_widget_add_short"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- 음성 · 사진(보조 버튼 · 선 1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/q11_l_r12"
            android:backgroundTint="#2EFFFFFF"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/q11_f_r12"
                android:backgroundTint="#1CFFFFFF"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q11_ic_mic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/q11_quick_voice"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/q11_l_r12"
            android:backgroundTint="#2EFFFFFF"
            android:padding="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/q11_f_r12"
                android:backgroundTint="#1CFFFFFF"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q11_ic_camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/q11_quick_photo"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
