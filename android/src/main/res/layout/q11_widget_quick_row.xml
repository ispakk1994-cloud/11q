<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 1 · 바로 적기 한 줄(4×1 · 2×1이면 음성 · 사진은 그림만) · 0.8.0 다듬기: 여백 좌우 12 · 로고 없음 · 선 1 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q11_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/q11_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/q11_bg_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/q11_qw_add_o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.4">

            <LinearLayout
                android:id="@+id/q11_qw_add_i"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/q11_f_r12"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/q11_qw_add_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q11_ic_plus" />

                <TextView
                    android:id="@+id/q11_qw_add_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/q11_widget_add_short"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/q11_qw_mic_o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/q11_qw_mic_i"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/q11_f_r12"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/q11_qw_mic_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q11_ic_mic" />

                <TextView
                    android:id="@+id/q11_qw_mic_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/q11_quick_voice"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/q11_qw_cam_o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/q11_qw_cam_i"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/q11_f_r12"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/q11_qw_cam_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q11_ic_camera" />

                <TextView
                    android:id="@+id/q11_qw_cam_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/q11_quick_photo"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
