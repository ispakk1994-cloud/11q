<?xml version="1.0" encoding="utf-8"?>
<!-- 0.7.0 위젯 1 · 바로 적기 한 줄(시안 WidgetMoreSizes 4×1 · 2×1이면 말로 · 사진은 그림만) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q11_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/q11_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/q11_bg_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/q11_logo"
            android:layout_width="26dp"
            android:layout_height="22dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/q11_round_white"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/q11_widget_title"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/q11_qw_add_o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1.4">

            <LinearLayout
                android:id="@+id/q11_qw_add_i"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/q11_f_r12"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/q11_qw_add_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q11_ic_plus" />

                <TextView
                    android:id="@+id/q11_qw_add_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/q11_widget_add_short"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/q11_qw_mic_o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/q11_l_r12"
            android:padding="1dp">

            <LinearLayout
                android:id="@+id/q11_qw_mic_i"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/q11_f_r12"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/q11_qw_mic_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q11_ic_mic" />

                <TextView
                    android:id="@+id/q11_qw_mic_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/q11_quick_voice"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/q11_qw_cam_o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/q11_l_r12"
            android:padding="1dp">

            <LinearLayout
                android:id="@+id/q11_qw_cam_i"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/q11_f_r12"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/q11_qw_cam_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q11_ic_camera" />

                <TextView
                    android:id="@+id/q11_qw_cam_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/q11_quick_photo"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
