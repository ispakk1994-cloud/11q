<?xml version="1.0" encoding="utf-8"?>
<!-- 할 일 한 줄(크게): 체크칸 · (지금) · (긴급/중요) · 제목 · 오른쪽 날짜 · 글자 크기는 위젯 설정 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q11_row"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/q11_chk"
        android:layout_width="36dp"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/q11_chk_box"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/q11_widget_check"
            android:src="@drawable/q11_chk_round" />

        <ImageView
            android:id="@+id/q11_chk_fill"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|start"
            android:importantForAccessibility="no"
            android:src="@drawable/q11_chk_round_fill"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/q11_chk_mark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|start"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/q11_ic_check"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/q11_body"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/q11_now"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/q11_round_white"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/q11_flag"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/q11_round_white"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/q11_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/q11_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
