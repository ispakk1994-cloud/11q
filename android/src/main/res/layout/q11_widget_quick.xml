<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 1 · 바로 적기 2×2 · 0.8.0 다듬기(시안 WidgetPolish): 여백 14 · 로고 없음 · 아래 설명 글 없음 · `말로` → `음성` · 음성 · 사진 선 1 · 낮게 놓으면 q11_widget_quick_row -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q11_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/q11_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/q11_bg_glass"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 머리(바로 적기) = 앱 -->
        <LinearLayout
            android:id="@+id/q11_qw_head"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/q11_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/q11_quick_label"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 적기(주 버튼) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <!-- 종이만: 적기 버튼 오른쪽 아래 그림자 2(앱 주 버튼과 같은 꼴) · 다른 테마는 숨김 -->
            <FrameLayout
                android:id="@+id/q11_qw_add_sh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/q11_f_r12"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/q11_qw_add_o"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:id="@+id/q11_qw_add_i"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/q11_f_r12"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/q11_qw_add_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/q11_ic_plus" />

                    <TextView
                        android:id="@+id/q11_qw_add_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/q11_widget_add_short"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- 음성 · 사진(보조 버튼 · 선 1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/q11_qw_mic_o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/q11_qw_mic_i"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/q11_f_r12"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/q11_qw_mic_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q11_ic_mic" />

                <TextView
                    android:id="@+id/q11_qw_mic_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/q11_quick_voice"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/q11_qw_cam_o"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/q11_qw_cam_i"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/q11_f_r12"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/q11_qw_cam_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/q11_ic_camera" />

                <TextView
                    android:id="@+id/q11_qw_cam_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/q11_quick_photo"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
