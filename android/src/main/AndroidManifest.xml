<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 30분 갱신 예약이 재부팅 뒤에도 남게(앱에 이미 있는 권한) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 작은 창 `말로 적기`: 폰의 음성 입력 창이 있는지 보려면(안드로이드 11 이상) -->
    <!-- 0.6.1: 앱 대화 탭 `말로 적기`(speech_to_text)가 폰의 받아쓰기 서비스를 찾게(안드로이드 11 이상 · 앱 매니페스트로 합쳐짐) -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application>
        <!-- 11Q 홈 화면 위젯 · 오늘 할 일 -->
        <receiver
            android:name="day.q11.widget.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/q11_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/q11_widget_today_info" />
        </receiver>

        <!-- 0.7.0 위젯 5 · 한 주(오늘부터 7일 · 날 고르기 · 그날 목록) -->
        <receiver
            android:name="day.q11.widget.WeekWidgetProvider"
            android:exported="false"
            android:label="@string/q11_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/q11_widget_week_info" />
        </receiver>

        <service
            android:name="day.q11.widget.WeekListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 0.7.0 위젯 1 · 바로 적기(적기 · 말로 = 작은 창 · 사진 = 11Q 카메라) -->
        <receiver
            android:name="day.q11.widget.QuickWidgetProvider"
            android:exported="false"
            android:label="@string/q11_quick_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/q11_widget_quick_info" />
        </receiver>

        <!-- 0.7.0 위젯 3 · 자료에 묻기(11Q 대화 · 입력칸 커서 / 말로 묻기) -->
        <receiver
            android:name="day.q11.widget.AskWidgetProvider"
            android:exported="false"
            android:label="@string/q11_ask_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/q11_widget_ask_info" />
        </receiver>

        <!-- 위젯 목록 줄 -->
        <service
            android:name="day.q11.widget.TodayListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 체크 · 15분 확인을 뒤에서(앱 코드 실행) -->
        <service
            android:name="day.q11.widget.WidgetJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 위젯 ＋ → 홈 화면 위 작은 창(앱은 안 열림 · 최근 앱 목록에 안 남음) -->
        <activity
            android:name="day.q11.widget.QuickAddActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="day.q11.widget.quickadd"
            android:theme="@style/Q11QuickAdd"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <!-- 위젯을 꾹 눌러 `설정` → 글자 크기(런처가 여는 화면이라 exported) -->
        <activity
            android:name="day.q11.widget.WidgetSettingsActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity="day.q11.widget.settings"
            android:theme="@style/Q11WidgetSettings">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
